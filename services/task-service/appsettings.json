{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(localdb)\\ProjectModels;Initial Catalog=TaskServiceDb;Integrated Security=True;TrustServerCertificate=True"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "task.exchange",
    "QueueName": "task.notifications",
    "RoutingKey": "task.assigned"
  },
  "spring": {
    "application": {
      "name": "task-service"
    }
  },
  "eureka": {
    "client": {
      "serviceUrl": "http://localhost:8761/eureka/"
    },
    "instance": {
      "port": 5256,
      "preferIpAddress": false,
      "nonSecurePortEnabled": true,
      "securePortEnabled": false
    }
  },
  "AllowedHosts": "*"
}